# GAP-22: migrate-only runs (Helm migration Job) apply Flyway and exit before the application context starts
org.springframework.boot.SpringApplicationRunListener=\
io.meridian.web.migrate.MigrateRunListener
# GAP-10: metric histogram / SLO bucket defaults
org.springframework.boot.EnvironmentPostProcessor=\
io.meridian.web.metrics.MetricsDefaults
