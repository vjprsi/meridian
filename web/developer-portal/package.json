{
  "name": "developer-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:specs": "node scripts/sync-specs.mjs",
    "predev": "node scripts/sync-specs.mjs",
    "dev": "next dev -p 13200",
    "prebuild": "node scripts/sync-specs.mjs",
    "build": "next build",
    "start": "next start -p 13200",
    "lint": "eslint",
    "gen:api": "openapi-typescript ../../generated/openapi/services/identity-service.openapi.yaml -o src/api/identity.d.ts && openapi-typescript ../../generated/openapi/services/webhook-service.openapi.yaml -o src/api/webhook.d.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.2",
    "next": "16.4.4",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
