# GAP-16: per-service identities of a cell.
#
# Kafka: every service is its own MSK principal (SASL AWS_MSK_IAM). Its Kubernetes service account (Helm chart: one per
# service, annotated with eks.amazonaws.com/role-arn when global.kafka.iam.enabled) assumes the IAM role below through
# the cell's EKS OIDC provider (IRSA). The role may produce only to the service's own domain topic, consume only the
# topics it subscribes to and use only consumer groups named after it. kafka-acls.json is generated by
# tools/kafka_acls.py from the spec (services.json, AsyncAPI) and the services' @KafkaListener annotations.
#
# OAuth: one Secrets Manager entry per service holds the client id / secret of its Keycloak client svc-<service>
# (synced into the namespace as Secret meridian-<service>-client by External Secrets; the values are written when the
# IdP clients are provisioned, never by OpenTofu).

locals {
  kafka_acls             = jsondecode(file("${path.module}/kafka-acls.json")).services
  kafka_topic_arn_prefix = replace(aws_msk_cluster.events.arn, ":cluster/", ":topic/")
  kafka_group_arn_prefix = replace(aws_msk_cluster.events.arn, ":cluster/", ":group/")
}

data "aws_iam_policy_document" "kafka_service_trust" {
  for_each = var.kafka_iam_enabled ? local.kafka_acls : {}
  statement {
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [module.eks.oidc_provider_arn]
    }
    condition {
      test     = "StringEquals"
      variable = "${module.eks.oidc_provider}:sub"
      values   = ["system:serviceaccount:${var.k8s_namespace}:${each.key}"]
    }
    condition {
      test     = "StringEquals"
      variable = "${module.eks.oidc_provider}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

data "aws_iam_policy_document" "kafka_service" {
  for_each = var.kafka_iam_enabled ? local.kafka_acls : {}
  statement {
    sid       = "Connect"
    actions   = ["kafka-cluster:Connect", "kafka-cluster:DescribeCluster", "kafka-cluster:WriteDataIdempotently"]
    resources = [aws_msk_cluster.events.arn]
  }
  statement {
    sid       = "ProduceOwnDomainTopic"
    actions   = ["kafka-cluster:DescribeTopic", "kafka-cluster:WriteData", "kafka-cluster:CreateTopic"]
    resources = [for t in each.value.produce : "${local.kafka_topic_arn_prefix}/${t}"]
  }
  dynamic "statement" {
    for_each = length(each.value.consume) > 0 ? [1] : []
    content {
      sid       = "ConsumeSubscribedTopics"
      actions   = ["kafka-cluster:DescribeTopic", "kafka-cluster:ReadData"]
      resources = [for t in each.value.consume : "${local.kafka_topic_arn_prefix}/${t}"]
    }
  }
  dynamic "statement" {
    for_each = length(each.value.consume) > 0 ? [1] : []
    content {
      sid       = "OwnConsumerGroups"
      actions   = ["kafka-cluster:DescribeGroup", "kafka-cluster:AlterGroup"]
      resources = ["${local.kafka_group_arn_prefix}/${each.value.group_prefix}*"]
    }
  }
}

resource "aws_iam_role" "kafka_service" {
  for_each             = var.kafka_iam_enabled ? local.kafka_acls : {}
  name                 = substr("${local.name}-kafka-${each.key}", 0, 64)
  description          = "MSK principal of ${each.key} (GAP-16, tools/kafka_acls.py)"
  assume_role_policy   = data.aws_iam_policy_document.kafka_service_trust[each.key].json
  max_session_duration = 3600
  tags                 = merge(local.tags, { "meridian:service" = each.key })
}

resource "aws_iam_role_policy" "kafka_service" {
  for_each = var.kafka_iam_enabled ? local.kafka_acls : {}
  name     = "kafka-topics"
  role     = aws_iam_role.kafka_service[each.key].id
  policy   = data.aws_iam_policy_document.kafka_service[each.key].json
}

resource "aws_secretsmanager_secret" "service_client" {
  for_each    = local.kafka_acls
  name        = "${local.name}/meridian-${each.key}-client"
  description = "client-id / client-secret of the Keycloak client svc-${each.key} (GAP-16)"
  kms_key_id  = aws_kms_key.cell.arn
  tags        = merge(local.tags, { "meridian:service" = each.key })

  dynamic "replica" {
    for_each = var.secret_replicas
    content {
      region     = replica.value.region
      kms_key_id = replica.value.kms_key_id
    }
  }
}
