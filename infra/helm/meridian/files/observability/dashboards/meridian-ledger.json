          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(meridian_ledger_posting_duration_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(meridian_ledger_posting_duration_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p99"
