          "expr": "histogram_quantile(0.5, sum by (le) (rate(meridian_cards_authorization_duration_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(meridian_cards_authorization_duration_seconds_bucket{cell=~\"$cell\"}[$__rate_interval])))",
          "legendFormat": "p90"
