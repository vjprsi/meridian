          "expr": "sum by (job) (rate(spring_kafka_listener_seconds_sum{cell=~\"$cell\",job=~\"$job\"}[$__rate_interval])) / sum by (job) (rate(spring_kafka_listener_seconds_count{cell=~\"$cell\",job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "legend": {
